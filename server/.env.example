# Beispielkonfiguration (lokal). Auf Plesk werden diese Werte in der Node.js-UI
# unter "Umgebungsvariablen" gesetzt. Niemals echte Werte ins Repository.

# PORT: Zahl oder Unix-Socket-Pfad (Plesk/Passenger setzt das selbst)
PORT=3001
# Schlüssel der verschlüsselten Datenbank: openssl rand -hex 32
# Geht er verloren, ist die Datenbank unlesbar. Getrennt vom Backup sichern.
DB_ENCRYPTION_KEY=
# Session- und Geheimnis-Secret: openssl rand -hex 32
SECRET=
# Öffentliche Adresse (für Links und Cookie-Einstellungen)
PUBLIC_URL=https://lernraumvr.bbz-rd-eck.com
# Daten (Datenbank, Uploads, Dateien) AUSSERHALB des Webverzeichnisses
DATA_DIR=./data
# Kommagetrennte LDAP-Benutzernamen der Admins
ADMIN_USERS=
# Größen in Bytes: Maximalgröße je Upload (Standard 10 GB) und Mindest-Freiplatz (Standard 20 GB)
MAX_UPLOAD_BYTES=10737418240
MIN_FREE_BYTES=21474836480
# Gleichzeitig aktive Downloads auf Brillen
MAX_PARALLEL_DOWNLOADS=8
# Stunden, nach denen unvollständige Uploads verfallen
UPLOAD_EXPIRY_HOURS=48

# Optional: Standardkontingent je Person in Bytes (leer = unbegrenzt; je Person in der Benutzerverwaltung änderbar)
DEFAULT_QUOTA_BYTES=
# ffprobe zur Prüfung von Videos (leer = nicht prüfen)
FFPROBE_PATH=ffprobe

# --- LDAP (Active Directory), Umsetzung wie in noten_webapp ---
# Ohne LDAP_URL ist keine Anmeldung möglich.
LDAP_URL=ldaps://dc.example.org
LDAP_BASE_DN=DC=schule,DC=local
# Service-Modus: Service-Konto sucht die Person, danach Bind mit deren Passwort
LDAP_BIND_DN=
LDAP_BIND_PW=
# Direkt-Modus (statt Service-Konto fuer den Login): z. B. SCHULE\{{username}}
LDAP_BIND_USER_TEMPLATE=
LDAP_USER_FILTER=(sAMAccountName={{username}})
LDAP_LOGIN_ATTR=sAMAccountName
LDAP_NAME_ATTR=displayName
# Nur Mitglieder dieser Gruppe duerfen sich anmelden (Name oder DN, auch verschachtelt)
LDAP_REQUIRED_GROUP=AAD-LUL
# Pfad zur PEM-Datei der internen CA (falls das Zertifikat nicht oeffentlich beglaubigt ist)
LDAP_TLS_CA_PFAD=
